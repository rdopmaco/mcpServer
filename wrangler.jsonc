{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acumatica-worker",
  "main": "src/index.js",
  "compatibility_date": "2026-10-20",
  "vars": {
    "ACUMATICA_BASE_URL": "https://saskarcgroup.acumatica.com",
    "ACUMATICA_API_VERSION": "24.200.001"
  },
  "secrets": {
    "required": [
      "ACUMATICA_USERNAME",
      "ACUMATICA_PASSWORD",
      "ACUMATICA_TENANT",
      "ACUMATICA_BRANCH"
    ]
  }
}
